               <item row="0" column="1"><widget class="QSpinBox" name="m_spinSlots"><property name="minimum"><number>16</number></property><property name="maximum"><number>2000</number></property><property name="value"><number>200</number></property></widget></item>
               <item row="1" column="0"><widget class="QLabel" name="txtWorkers"><property name="text"><string>Worker Count / 推理线程:</string></property><property name="role" stdset="0"><string>rowTitle</string></property></widget></item>
               <item row="1" column="1"><widget class="QSpinBox" name="m_spinWorkerCount"><property name="minimum"><number>0</number></property><property name="maximum"><number>16</number></property><property name="specialValueText"><string>Auto / 自动</string></property><property name="value"><number>0</number></property></widget></item>
               <item row="2" column="0"><widget class="QLabel" name="txtStreams"><property name="text"><string>Parallel Infer / 并行推理数:</string></property><property name="role" stdset="0"><string>rowTitle</string></property></widget></item>
               <item row="2" column="1"><widget class="QSpinBox" name="m_spinInferenceStreams"><property name="minimum"><number>1</number></property><property name="maximum"><number>8</number></property><property name="value"><number>2</number></property></widget></item>
               <item row="3" column="0"><widget class="QLabel" name="txtBatchParam"><property name="text"><string>Worker Max Batch / 最大批量:</string></property><property name="role" stdset="0"><string>rowTitle</string></property></widget></item>
               <item row="3" column="1"><widget class="QSpinBox" name="m_spinBatch"><property name="minimum"><number>1</number></property><property name="maximum"><number>32</number></property><property name="value"><number>16</number></property></widget></item>
               <item row="4" column="0"><widget class="QLabel" name="txtCtxPoolParam"><property name="text"><string>Context Pool / 上下文池:</string></property><property name="role" stdset="0"><string>rowTitle</string></property></widget></item>
               <item row="4" column="1"><widget class="QSpinBox" name="m_spinContextPool"><property name="minimum"><number>0</number></property><property name="maximum"><number>8</number></property><property name="specialValueText"><string>Auto / 自动</string></property><property name="value"><number>0</number></property></widget></item>
               <item row="5" column="0"><widget class="QLabel" name="txtStats"><property name="text"><string>Stats Interval / 统计间隔:</string></property><property name="role" stdset="0"><string>rowTitle</string></property></widget></item>
               <item row="5" column="1"><widget class="QSpinBox" name="m_spinStatsInterval"><property name="minimum"><number>1</number></property><property name="maximum"><number>60</number></property><property name="value"><number>5</number></property><property name="suffix"><string> s</string></property></widget></item>
              </layout>
             </item>
            </layout>
