  <property name="styleSheet">
   <string>/* Gem-gray + Jade Light Theme */
QMainWindow, QWidget {
    background-color: #ecf3f0;
    color: #334155;
    font-family: &quot;Segoe UI&quot;, &quot;Microsoft YaHei&quot;, sans-serif;
    font-size: 10pt;
}

QWidget#centralwidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #eef4f1,
        stop:0.6 #e8f0ed,
        stop:1 #dfe9e5);
}

QMenuBar {
    background: #dfe9e5;
    border: none;
    border-bottom: 1px solid #c5d7d0;
    color: #2f4350;
    font-weight: 700;
}

QWidget#customTitleBarMain {
    background: #dfe9e5;
    border: none;
    border-bottom: 2px solid #c5d7d0;
}
QLabel#mainTitleLabel {
    color: #2f4350;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.5px;
}
QPushButton#titleMinButton,
QPushButton#titleMaxButton,
QPushButton#titleCloseButtonMain {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    border-radius: 6px;
    font-size: 12px;
    padding: 0px;
    font-weight: 700;
}
QPushButton#titleMinButton,
QPushButton#titleMaxButton {
    background: #edf4f1;
    color: #355260;
    border: 1px solid #b9ccc5;
}
QPushButton#titleMinButton:hover,
QPushButton#titleMaxButton:hover {
    background: #dcebe5;
    border: 1px solid #a7bfb6;
}
QPushButton#titleCloseButtonMain {
    background: #fbe3e1;
    color: #B91C1C;
    border: 1px solid #edc9c5;
}
QPushButton#titleCloseButtonMain:hover {
    background: #f7d4d0;
    border: 1px solid #e5b9b2;
}
QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background: rgba(224, 237, 231, 0.95);
}

QFrame#frame_controls {
    background: rgba(235, 243, 239, 0.95);
    border: 1px solid #c3d4ce;
    border-radius: 12px;
}

QGroupBox {
    border: 1px solid #c2d3cd;
    border-radius: 10px;
    margin-top: 32px;
    font-weight: 700;
    background-color: rgba(241, 248, 245, 0.95);
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    top: 0px;
    padding: 3px 10px;
    color: #2e4c57;
    background-color: rgba(223, 236, 230, 0.95);
    border: 1px solid #b8ccc4;
    border-radius: 8px;
    font-size: 10pt;
}

QPushButton {
    background-color: rgba(236, 246, 242, 0.98);
    color: #2f4652;
    border: 1px solid #b9cdc6;
    padding: 7px 14px;
    border-radius: 7px;
    font-weight: 700;
}
QPushButton:hover {
    background-color: rgba(224, 239, 233, 0.98);
    border: 1px solid #9ebdb3;
}
QPushButton:pressed {
    background-color: rgba(212, 230, 222, 0.98);
}

QPushButton#btn_start {
    background-color: #7faea0;
    color: #ffffff;
    border: 1px solid #6d998c;
}
QPushButton#btn_start:hover { background-color: #6f9f91; }

QPushButton#btn_stop {
    background-color: #d26d6d;
    color: #ffffff;
    border: 1px solid #be5f5f;
}
QPushButton#btn_stop:hover { background-color: #c95f5f; }

QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QLineEdit {
    background-color: rgba(255, 255, 255, 0.93);
    border: 1px solid #bfd0ca;
    color: #324654;
    padding: 4px;
    border-radius: 6px;
}

QTabWidget::pane {
    border: 1px solid #c4d5cf;
    border-radius: 8px;
    background: rgba(236, 245, 241, 0.85);
}
QTabBar::tab {
    background: transparent;
    color: #617686;
    padding: 7px 14px;
    border-bottom: none;
    border-radius: 6px;
    font-weight: 700;
}
QTabBar::tab:selected {
    color: #2f5c52;
    background: rgba(218, 235, 229, 0.95);
    border: 1px solid #b3cbc2;
}

QPushButton#btn_back_to_grid,
QPushButton#btn_pause,
QPushButton#btn_snapshot {
    background-color: #7faea0;
    color: #ffffff;
    border: 1px solid #6d998c;
    font-weight: 700;
}
QPushButton#btn_back_to_grid:hover,
QPushButton#btn_pause:hover,
QPushButton#btn_snapshot:hover {
    background-color: #6f9f91;
    border: 1px solid #608a7e;
}

QTableWidget {
    background: rgba(247, 252, 250, 0.95);
    border: 1px solid #c3d4ce;
    gridline-color: #d9e6e1;
    alternate-background-color: #f1f8f5;
}
QHeaderView::section {
    background: rgba(223, 236, 230, 0.95);
    color: #3d5563;
    border: none;
    border-right: 1px solid #c6d6d0;
    padding: 6px;
    font-weight: 700;
}</string>
